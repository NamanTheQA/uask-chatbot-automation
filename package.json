{
  "name": "u-ask-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:parallel": "npx playwright test --workers=4",
    "test:sequential": "npx playwright test --workers=1",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:mobile": "npx playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:headed": "cross-env HEADED=true npx playwright test",
    "test:r9int": "cross-env ENV=r9int npx playwright test",
    "test:prod": "cross-env ENV=prod npx playwright test",
    "test:prod-headed": "cross-env ENV=prod HEADED=true npx playwright test",
    "test:r9int-headed": "cross-env ENV=r9int HEADED=true npx playwright test",
    "test:ui": "npx playwright test tests/ui/ui.spec.ts",
    "test:multilingual": "npx playwright test tests/ui/multilingual.spec.ts",
    "test:ai": "npx playwright test tests/ai/ai.spec.ts",
    "test:score": "npx playwright test tests/ai/ai.score.spec.ts",
    "test:security": "npx playwright test tests/security/security.spec.ts",
    "test:a11y": "npx playwright test tests/accessibility/a11y.spec.ts",
    "report": "npx playwright show-report",
    "allure:generate": "allure generate reports/prod/allure/results -o reports/prod/allure/report --clean",
    "allure:open": "allure open"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^25.1.0",
    "allure-playwright": "^3.4.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "dotnet": "^1.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
